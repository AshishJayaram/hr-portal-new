<svg width="1024" height="1024" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Liquid Glass Background -->
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5CF6"/>
      <stop offset="50%" style="stop-color:#3B82F6"/>
      <stop offset="100%" style="stop-color:#06B6D4"/>
    </linearGradient>
    
    <!-- Glass Overlay -->
    <linearGradient id="glass" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:0.4"/>
      <stop offset="50%" style="stop-color:#FFFFFF;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#FFFFFF;stop-opacity:0.3"/>
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1024" height="1024" rx="200" fill="url(#bg)"/>
  
  <!-- Glass Overlay -->
  <rect width="1024" height="1024" rx="200" fill="url(#glass)"/>
  
  <!-- HR Icon - Modern People -->
  <g transform="translate(512, 512)">
    <!-- Person 1 -->
    <circle cx="-120" cy="-40" r="70" fill="rgba(255,255,255,0.95)" stroke="rgba(255,255,255,0.6)" stroke-width="4"/>
    <rect x="-150" y="30" width="60" height="120" rx="30" fill="rgba(255,255,255,0.95)" stroke="rgba(255,255,255,0.6)" stroke-width="4"/>
    
    <!-- Person 2 -->
    <circle cx="120" cy="-40" r="70" fill="rgba(255,255,255,0.95)" stroke="rgba(255,255,255,0.6)" stroke-width="4"/>
    <rect x="90" y="30" width="60" height="120" rx="30" fill="rgba(255,255,255,0.95)" stroke="rgba(255,255,255,0.6)" stroke-width="4"/>
    
    <!-- Connection -->
    <line x1="-50" y1="-40" x2="50" y2="-40" stroke="rgba(255,255,255,0.9)" stroke-width="8" stroke-linecap="round"/>
    
    <!-- Base -->
    <ellipse cx="0" cy="180" rx="240" ry="40" fill="rgba(255,255,255,0.4)" stroke="rgba(255,255,255,0.6)" stroke-width="4"/>
  </g>
  
  <!-- Glass Highlight -->
  <ellipse cx="400" cy="360" rx="160" ry="80" fill="rgba(255,255,255,0.3)" transform="rotate(-30 400 360)"/>
</svg>
